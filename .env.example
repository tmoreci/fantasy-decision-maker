# Required: your TypeSafe AI key (https://typesafe.ai)
TYPESAFE_API_KEY=ts_...

# Optional overrides
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=info

# Optional: Sleeper identity, so you can omit --league / --username on every run
# SLEEPER_USERNAME=yourname
# SLEEPER_LEAGUE_ID=123456789012345678

# ---- Web app (start-who-web) ----
# Shared passcode for your league. Leave unset to run the site open (local use only).
# APP_PASSCODE=pick-a-passcode
# Cap on decisions per visitor IP per hour, to protect your TypeSafe bill.
# DECISIONS_PER_HOUR=30
# Where the cache and decision history live; point it at a persistent volume in production.
# FDM_CACHE_DIR=/data
# Set to 0 to skip nflverse usage metrics (lighter, faster, less signal).
# FDM_ADVANCED=1
# HOST=127.0.0.1
# PORT=8000
